# Existing contact form and advertising reports both use Resend.
RESEND_API_KEY=
# Production only. Enable after the one-off test has been confirmed.
ADS_REPORTS_ENABLED=false
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Set as a sensitive Production environment variable in Vercel.
CRON_SECRET=
# VERCEL_ENV is automatically supplied by Vercel; do not override it.
